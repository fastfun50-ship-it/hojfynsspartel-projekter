SESSION_SECRET=skift-mig-til-mindst-32-tegn-hemmelighed
# Local demo: leave Turso/DATABASE_URL empty -> sql.js at data/app.db
# Vercel durable (pick ONE):
#   A) Turso: set TURSO_DATABASE_URL (preferred) OR DATABASE_URL + token
#   B) Blob: set BLOB_READ_WRITE_TOKEN (persists sql.js DB across isolates)
# SESSION_SECRET alone is NOT enough for create→detail on Vercel.
TURSO_DATABASE_URL=
# DATABASE_URL=
TURSO_AUTH_TOKEN=
# AUTH_TOKEN=
# Alternative / also for image uploads:
BLOB_READ_WRITE_TOKEN=
